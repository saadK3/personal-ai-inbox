# Application
APP_NAME=Personal AI Inbox
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_inbox

# Discord (fill these in before running the bot)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=

# The Application ID and Public Key are not needed by the current
# Gateway-based DM bot, so they are intentionally not configured here.

# Model providers
OPENAI_API_KEY=
# Keep these explicit so model choice is visible and does not depend on SDK defaults.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small returns 1536 dimensions by default.
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Local durable media storage for development
STORAGE_DIR=./data
