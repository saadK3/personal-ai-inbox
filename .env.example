# Application
APP_NAME=Personal AI Inbox
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_inbox

# Discord (fill these in before running the bot)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=

# The Application ID and Public Key are not needed by the current
# Gateway-based DM bot, so they are intentionally not configured here.

# Model providers (fill these in before implementing enrichment)
OPENAI_API_KEY=

# Local durable media storage for development
STORAGE_DIR=./data
